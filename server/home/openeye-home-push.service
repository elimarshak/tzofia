[Unit]
Description=OPENEYE home station: send received aircraft to the site
After=network-online.target readsb.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/openeye/openeye-home-push.py
LoadCredential=homekey:/etc/openeye/home.key
DynamicUser=yes
Restart=always
RestartSec=10
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
